{
  "name": "cntdashboard",
  "compatibility_date": "2026-09-08",
  "main": "generated-worker.js",
  "build": {
    "command": "node build-worker.mjs"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "RESULTS_DB",
      "database_name": "cntdashboard-results",
      "database_id": "5ce15450-f7e1-44f9-a82c-81ceda64c4ae"
    }
  ]
}
