{
  "name": "cntdashboard",
  "compatibility_date": "2026-09-08",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare's asset handler intercepts EVERY request (including /api/insights)
    // before the Worker script ever runs: since /api/insights doesn't match a static file, it fell
    // through to the single-page-application fallback and silently served index.html instead of
    // reaching handleInsights() in worker.js — meaning the live-fetch button could never have worked,
    // regardless of any Meta token being set correctly. Routing /api/* to the Worker first fixes this.
    "run_worker_first": ["/api/*"]
  }
}
