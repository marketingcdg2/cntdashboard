{
  "name": "cntdashboard",
  "compatibility_date": "2026-09-08",
  "main": "generated-worker.js",
  "build": {
    "command": "node build-worker.mjs"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
